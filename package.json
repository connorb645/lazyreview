{
  "name": "lazyreview",
  "version": "0.1.0",
  "private": true,
  "description": "Review GitHub pull requests and stacks on your own machine, in a terminal, with a class diagram of each change.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "lazyreview": "bin/lazyreview"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test 'test/**/*.test.mjs'",
    "test:terminal": "cd terminal && go test ./...",
    "docs": "cd terminal && go generate ./internal/config"
  }
}
