#!/usr/bin/env node
// lazyreview-guard: Claude Code's PreToolUse hook while it answers in a copy
// of the code. Run as `lazyreview-guard <copy folder>`, with the hook's input
// on standard input; it allows or refuses the tool call.
import { readFileSync } from 'node:fs';
import { hookAnswer } from '../src/ask/hook-answer.mjs';

const { output, code } = hookAnswer(readFileSync(0, 'utf8'), { copy: process.argv[2] });
(code === 0 ? process.stdout : process.stderr).write(output);
process.exitCode = code;
