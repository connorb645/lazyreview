#!/usr/bin/env node
// review-desk: loads pull requests into the Review Desk app, and runs the app.
// Run `review-desk help` for the commands.
import { fileURLToPath } from 'node:url';
import { run } from '../src/cli/main.mjs';

try {
  const lines = await run(process.argv.slice(2), { env: process.env, bin: fileURLToPath(import.meta.url) });
  for (const line of lines) console.log(line);
} catch (error) {
  console.error(`review-desk: ${error.message}`);
  process.exitCode = 1;
}
