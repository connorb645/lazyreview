#!/usr/bin/env node
// lazyreview: loads pull requests into the lazyreview app, and runs the app.
// Run `lazyreview help` for the commands.
import { run } from '../src/cli/main.mjs';
import { english } from '../src/i18n/english.mjs';

try {
  const lines = await run(process.argv.slice(2), { env: process.env, say: line => console.log(line) });
  for (const line of lines) console.log(line);
} catch (error) {
  console.error(english.cli.failed(error.message));
  process.exitCode = 1;
}
